<?xml version="1.0" encoding="UTF-8"?>
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">

    <!-- ============================================================
    Quadrilátero Central de Curitiba - Nós (Interseções)
    
    Eixo vertical (norte-sul):
      - Presidente Kennedy:       x = 0
      - Calçadão da XV:           x = 280
      - Mal. Floriano Peixoto:    x = 620
    
    Eixo horizontal (leste-oeste):
      - Martim Afonso:            y = 2200
      - XV entre Afonso/Torres:   y = 1200  
      - Mariano Torres:           y = 600
      - Mário Tourinho:           y = 0
    ============================================================ -->

    <!-- Coluna Pres. Kennedy (x=0) -->
    <node id="K1"  x="0"    y="2200" type="traffic_light"/>  <!-- Kennedy × Martim Afonso -->
    <node id="K2"  x="0"    y="1600" type="priority"/>       <!-- Kennedy × intermediário 1 -->
    <node id="K3"  x="0"    y="1200" type="traffic_light"/>  <!-- Kennedy × XV -->
    <node id="K4"  x="0"    y="900"  type="priority"/>       <!-- Kennedy × intermediário 2 -->
    <node id="K5"  x="0"    y="600"  type="traffic_light"/>  <!-- Kennedy × Mariano Torres -->
    <node id="K6"  x="0"    y="300"  type="priority"/>       <!-- Kennedy × intermediário 3 -->
    <node id="K7"  x="0"    y="0"    type="traffic_light"/>  <!-- Kennedy × Mário Tourinho -->

    <!-- Coluna Calçadão da XV (x=280) - pedestres, interseções como crossings -->
    <node id="X1"  x="280"  y="2200" type="traffic_light"/>  <!-- XV × Martim Afonso -->
    <node id="X2"  x="280"  y="1200" type="traffic_light"/>  <!-- XV × transversal central -->
    <node id="X3"  x="280"  y="600"  type="traffic_light"/>  <!-- XV × Mariano Torres -->
    <node id="X4"  x="280"  y="0"    type="traffic_light"/>  <!-- XV × Mário Tourinho -->

    <!-- Coluna Mal. Floriano (x=620) -->
    <node id="F1"  x="620"  y="2200" type="traffic_light"/>  <!-- Floriano × Martim Afonso -->
    <node id="F2"  x="620"  y="1600" type="priority"/>       <!-- Floriano × intermediário 1 -->
    <node id="F3"  x="620"  y="1200" type="traffic_light"/>  <!-- Floriano × XV -->
    <node id="F4"  x="620"  y="900"  type="priority"/>       <!-- Floriano × intermediário 2 -->
    <node id="F5"  x="620"  y="600"  type="traffic_light"/>  <!-- Floriano × Mariano Torres -->
    <node id="F6"  x="620"  y="300"  type="priority"/>       <!-- Floriano × intermediário 3 -->
    <node id="F7"  x="620"  y="0"    type="traffic_light"/>  <!-- Floriano × Mário Tourinho -->

    <!-- Nós auxiliares de entrada/saída (bordas da simulação) -->
    <node id="N_in"   x="0"    y="2500" type="priority"/>    <!-- Entrada norte Kennedy -->
    <node id="N_out"  x="0"    y="-300" type="priority"/>    <!-- Saída sul Kennedy -->
    <node id="S_in"   x="620"  y="-300" type="priority"/>    <!-- Entrada sul Floriano -->
    <node id="S_out"  x="620"  y="2500" type="priority"/>    <!-- Saída norte Floriano -->
    <node id="L_in"   x="-400" y="2200" type="priority"/>    <!-- Entrada leste Afonso -->
    <node id="L_out"  x="1020" y="2200" type="priority"/>    <!-- Saída oeste Afonso -->
    <node id="L2_in"  x="-400" y="600"  type="priority"/>    <!-- Entrada leste Torres -->
    <node id="L2_out" x="1020" y="600"  type="priority"/>    <!-- Saída oeste Torres -->
    <node id="L3_in"  x="-400" y="0"    type="priority"/>    <!-- Entrada leste Tourinho -->
    <node id="L3_out" x="1020" y="0"    type="priority"/>    <!-- Saída oeste Tourinho -->

</nodes>
