<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="quadrilatero.net.xml"/>
        <route-files value="quadrilatero.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="9000"/>     <!-- 2.5h = janela de pico matutina -->
    </time>

    <processing>
        <step-length value="0.1"/>
        <lateral-resolution value="1.6"/>
        <default.action-step-length value="0.1"/>
    </processing>

    <output>
        <!-- TripInfo: métricas individuais de cada veículo -->
        <tripinfo-output value="results/tripinfo_asis.xml"/>
        <tripinfo-output.write-unfinished value="true"/>

        <!-- Emission outputs -->
        <emission-output value="results/emissions_asis.xml"/>
        <emission-output.precision value="4"/>

        <!-- Edge-based traffic measures -->
        <edgebased-output value="results/edgedata_asis.xml"/>
        <edgebased-output.period value="300"/>

        <!-- Lane area detectors (virtual loops) output -->
        <lanechange-output value="results/lanechange_asis.xml"/>
    </processing>

    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
        <no-warnings value="false"/>
    </report>

    <random>
        <seed value="42"/>
    </random>

</configuration>
