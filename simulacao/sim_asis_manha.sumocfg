<configuration>
    <input>
        <net-file value="curitiba.net.xml"/>
        <route-files value="demanda_manha.rou.xml"/>
    </input>
    <output>
        <tripinfo-output value="outputs/tripinfo_asis_manha.xml"/>
        <summary-output value="outputs/summary_asis_manha.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="9000"/>
    </time>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
